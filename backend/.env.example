# Copy to backend/.env (git-ignored) and fill in. Never commit real values.
EHR_ENVIRONMENT=development
EHR_LOG_LEVEL=INFO
EHR_DATABASE_URL=sqlite:///./data/ehr.db
EHR_MAX_UPLOAD_BYTES=5242880

# AI clinical summaries. Leave EHR_OPENAI_API_KEY empty to run without AI:
# POST /patients/{id}/summary then answers 503 and everything else works.
EHR_OPENAI_API_KEY=
EHR_OPENAI_MODEL=gpt-4o-mini
EHR_OPENAI_TIMEOUT_SECONDS=30
EHR_OPENAI_TEMPERATURE=0.0
EHR_SUMMARY_MAX_ATTEMPTS=3
EHR_SUMMARY_RETRY_BASE_SECONDS=1.0
EHR_SUMMARY_MAX_CONTEXT_RECORDS=20
EHR_SUMMARY_MAX_CHARS_PER_RECORD=4000
EHR_SUMMARY_MAX_OUTPUT_TOKENS=1200
